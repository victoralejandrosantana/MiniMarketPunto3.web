<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Tienda Pro</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
body{font-family:Arial;background:#f4f4f4;margin:10px}
h1{text-align:center}
.section{background:white;padding:15px;margin:10px 0;border-radius:12px}
input,button,select{margin:5px;padding:8px;font-size:14px}
.producto{display:flex;flex-wrap:wrap;gap:5px;margin:5px 0;align-items:center}
.cliente{border:1px solid #ccc;padding:10px;margin-top:10px;border-radius:10px}
.total{font-size:18px;font-weight:bold;margin-top:10px}
</style>
</head>
<body>

<h1>Mini Tienda</h1>

<div class="section">
<h2>Inventario</h2>

<input id="nombre" placeholder="Producto">
<input id="precio" type="number" placeholder="Precio">
<input id="stock" type="number" placeholder="Cantidad">

<select id="categoria">
<option value="cerveza">🍺 Cerveza</option>
<option value="panaderia">🍞 Panadería</option>
<option value="galletas">🍪 Galletas</option>
<option value="galguerias">🍬 Galguerías</option>
<option value="jugos">🧃 Jugos</option>
<option value="agua">💧 Agua</option>
<option value="cereales">🥣 Cereales</option>
<option value="papas">🥔 Papas</option>
<option value="medicinas">💊 Medicinas</option>
<option value="detergentes">🧼 Detergentes</option>
<option value="papeleria">📒 Papelería</option>
<option value="empanadas">🥟 Empanadas</option>
<option value="helados">🍦 Helados</option>
</select>

<button onclick="agregarProducto()">Agregar</button>
</div>

<!-- CATEGORÍAS -->
<div id="cerveza" class="section"><h3>🍺 Cerveza</h3></div>
<div id="panaderia" class="section"><h3>🍞 Panadería</h3></div>
<div id="galletas" class="section"><h3>🍪 Galletas</h3></div>
<div id="galguerias" class="section"><h3>🍬 Galguerías</h3></div>
<div id="jugos" class="section"><h3>🧃 Jugos</h3></div>
<div id="agua" class="section"><h3>💧 Agua</h3></div>
<div id="cereales" class="section"><h3>🥣 Cereales</h3></div>
<div id="papas" class="section"><h3>🥔 Papas</h3></div>
<div id="medicinas" class="section"><h3>💊 Medicinas</h3></div>
<div id="detergentes" class="section"><h3>🧼 Detergentes</h3></div>
<div id="papeleria" class="section"><h3>📒 Papelería</h3></div>
<div id="empanadas" class="section"><h3>🥟 Empanadas</h3></div>
<div id="helados" class="section"><h3>🍦 Helados</h3></div>

<!-- VENTAS -->
<div class="section">
<h2>Ventas del día</h2>
<div id="ventas"></div>
<p id="total" class="total">Total: $0</p>
</div>

<!-- VENTAS RETRASADAS -->
<div class="section">
<h2>Ventas retrasadas</h2>
<button onclick="crearCliente()">➕ Persona</button>
<div id="clientes"></div>
</div>

<!-- 🔥 FIREBASE -->
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-app.js";
import { getFirestore, doc, setDoc, getDoc } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyDoGtC6gpwi3hPkFn2FU5Zr5vL4a4GcdyQ",
  authDomain: "minimarketpunto3-117ce.firebaseapp.com",
  projectId: "minimarketpunto3-117ce",
  storageBucket: "minimarketpunto3-117ce.firebasestorage.app",
  messagingSenderId: "770945278500",
  appId: "1:770945278500:web:28643ea68990bcebec2eb1"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

window.db = db;
window.setDoc = setDoc;
window.getDoc = getDoc;
window.doc = doc;
</script>

<script>
let inventario=[];
let ventas=[];
let clientes=[];

async function guardarTodo(){
 localStorage.setItem("inventario", JSON.stringify(inventario));
 localStorage.setItem("ventas", JSON.stringify(ventas));
 localStorage.setItem("clientes", JSON.stringify(clientes));

 if(window.db){
  await setDoc(doc(db,"tienda","datos"),{
   inventario, ventas, clientes
  });
 }
}

async function cargarTodo(){
 if(window.db){
  let docRef = doc(db,"tienda","datos");
  let docSnap = await getDoc(docRef);

  if(docSnap.exists()){
   let data = docSnap.data();
   inventario = data.inventario || [];
   ventas = data.ventas || [];
   clientes = data.clientes || [];
  }
 }

 renderInventario();
 actualizarVentas();
 renderClientes();
}

function agregarProducto(){
 let n=document.getElementById('nombre').value.toLowerCase();
 let p=parseFloat(document.getElementById('precio').value);
 let s=parseInt(document.getElementById('stock').value);
 let c=document.getElementById('categoria').value;

 if(!n||isNaN(p)||isNaN(s)) return alert("Faltan datos");

 inventario.push({nombre:n,precio:p,stock:s,categoria:c});
 guardarTodo();
 renderInventario();
}

function renderInventario(){
 document.querySelectorAll('.section').forEach(sec=>{
  if(sec.id) sec.innerHTML = sec.innerHTML.split('</h3>')[0] + '</h3>';
 });

 inventario.forEach((prod,i)=>{
  let div=document.createElement('div');
  div.className='producto';

  let nombre=document.createElement('input');
  nombre.value=prod.nombre;

  let precio=document.createElement('input');
  precio.type='number'; precio.value=prod.precio;

  let stock=document.createElement('input');
  stock.type='number'; stock.value=prod.stock;

  let cantidad=document.createElement('input');
  cantidad.type='number'; cantidad.value=1;

  let vender=document.createElement('button');
  vender.textContent='Vender';

  let eliminar=document.createElement('button');
  eliminar.textContent='🗑️';

  eliminar.onclick=()=>{
   inventario.splice(i,1);
   guardarTodo();
   renderInventario();
  };

  vender.onclick=()=>{
   let cant=parseInt(cantidad.value);
   if(cant>prod.stock) return alert("No hay suficiente");

   prod.stock-=cant;
   ventas.push({nombre:prod.nombre,precio:prod.precio,cantidad:cant});

   guardarTodo();
   renderInventario();
   actualizarVentas();
  };

  div.append(nombre,precio,stock,cantidad,vender,eliminar);
  document.getElementById(prod.categoria).appendChild(div);
 });
}

function actualizarVentas(){
 let cont=document.getElementById('ventas');
 cont.innerHTML='';
 let total=0;

 ventas.forEach((v,i)=>{
  let sub=v.precio*v.cantidad;
  total+=sub;

  let d=document.createElement('div');
  d.innerHTML=`${v.nombre} x${v.cantidad} - $${sub} <button onclick="eliminarVenta(${i})">❌</button>`;
  cont.appendChild(d);
 });

 document.getElementById('total').textContent="Total: $"+total;
}

function eliminarVenta(i){
 ventas.splice(i,1);
 guardarTodo();
 actualizarVentas();
}

function crearCliente(){
 let nombre=prompt("Nombre cliente");
 if(!nombre) return;

 clientes.push({nombre:nombre,lista:[]});
 guardarTodo();
 renderClientes();
}

function renderClientes(){
 let cont=document.getElementById('clientes');
 cont.innerHTML='';

 clientes.forEach((c,ci)=>{
  let box=document.createElement('div');
  box.className='cliente';

  let titulo=document.createElement('h4');
  titulo.textContent=c.nombre;

  let producto=document.createElement('input');
  let precio=document.createElement('input'); precio.type='number';
  let cantidad=document.createElement('input'); cantidad.type='number'; cantidad.value=1;

  let guardar=document.createElement('button'); guardar.textContent='Guardar';

  let eliminarPersona=document.createElement('button');
  eliminarPersona.textContent='🗑️';
  eliminarPersona.onclick=()=>{
   clientes.splice(ci,1);
   guardarTodo();
   renderClientes();
  };

  guardar.onclick=()=>{
   c.lista.push({producto:producto.value,precio:parseFloat(precio.value),cantidad:parseInt(cantidad.value)});
   guardarTodo();
   renderClientes();
  };

  let lista=document.createElement('div');
  let total=0;

  c.lista.forEach((item,ii)=>{
   let sub=item.precio*item.cantidad;
   total+=sub;

   let d=document.createElement('div');
   d.innerHTML=`${item.producto} x${item.cantidad} = $${sub} <button onclick="eliminarItem(${ci},${ii})">❌</button>`;
   lista.appendChild(d);
  });

  let totalDiv=document.createElement('div');
  totalDiv.textContent=`Debe: $${total}`;

  let cobrar=document.createElement('button');
  cobrar.textContent='💰';

  cobrar.onclick=()=>{
   c.lista.forEach(i=>{
    ventas.push({nombre:i.producto,precio:i.precio,cantidad:i.cantidad});
    let prod=inventario.find(p=>p.nombre===i.producto);
    if(prod) prod.stock-=i.cantidad;
   });

   clientes.splice(ci,1);
   guardarTodo();
   renderClientes();
   renderInventario();
   actualizarVentas();
  };

  box.append(titulo,producto,precio,cantidad,guardar,eliminarPersona,lista,totalDiv,cobrar);
  cont.appendChild(box);
 });
}

function eliminarItem(ci,ii){
 clientes[ci].lista.splice(ii,1);
 guardarTodo();
 renderClientes();
}

window.onload=cargarTodo;
</script>

</body>
</html>
